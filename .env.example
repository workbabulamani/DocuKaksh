# Copy this file to .env and fill in the values. .env is never committed or copied into the image.
# Generate the encryption key with:  npm run gen-key   (or: docker compose run --rm docukaksh node src/cli.js gen-key)

# REQUIRED. 32 random bytes, base64. Every uploaded file is encrypted with it.
# Keep a copy somewhere safe: without this key the stored files cannot be opened.
ENCRYPTION_KEY=

# Where the database and encrypted files are kept on this machine (Docker compose mounts this folder).
# Use an absolute path to put the data on another drive, for example D:/DocuKaksh-data
DATA_HOST_DIR=./docukaksh-data

# HTTP port on this machine.
PORT=3000

# 0.0.0.0 lets other devices on your network open the app. 127.0.0.1 allows this computer only.
HOST=0.0.0.0

# Set to true when the app is served over HTTPS (behind a reverse proxy).
COOKIE_SECURE=false

# Largest single file accepted for upload, in megabytes.
MAX_UPLOAD_MB=100

# Items in the recycle bin are removed for good after this many days. 0 keeps them forever.
RECYCLE_RETENTION_DAYS=30

# Sign-in protection: lock an account or address after this many failed attempts, for this many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
